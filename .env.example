# Copy to .env (local) or set in Vercel. Never commit real values.
DATABASE_URL=                      # Neon pooled connection string
APP_BASE_URL=http://localhost:3000
APP_SIGNING_SECRET=                # 32+ random chars (outcome links, sessions)
CRON_SECRET=                       # Vercel Cron bearer secret
DASHBOARD_USERS=                   # "nikhil@x.com:founder,shashank@x.com:admin"  TODO(owner)

VAANI_WEBHOOK_SECRET=              # vv_whk_... shown once in the Vaani dashboard

GEMINI_API_KEY=                    # AI Studio key (starts AIza)
GEMINI_MODEL=gemini-3.5-flash      # owner's choice; API_NOTES suggests gemini-3.5-flash-lite as cheapest

RESEND_API_KEY=
RESEND_FROM=                       # e.g. "Aangan Studio <hello@yourdomain>"  TODO(owner)
EMAIL_ALLOWLIST=                   # comma list; while set, only these receive mail (until domain verified)
FRONT_DESK_EMAILS=                 # reply-to + fallback  TODO(owner)
QUALIFIED_FALLBACK_EMAILS=         # TODO(owner)
OPS_ALERT_EMAIL=                   # TODO(owner)

CALENDLY_TOKEN=                    # personal access token (paid plan, scheduled_events:write)
CALENDLY_EVENT_TYPE_URI=           # https://api.calendly.com/event_types/...
CALENDLY_LOCATION_JSON=            # optional; omit for round-robin event types

HUBSPOT_ACCESS_TOKEN=              # private app token
HUBSPOT_TASK_OWNER_ID=             # optional  TODO(owner)
HUBSPOT_STATUS_PROPERTY=hs_lead_status
